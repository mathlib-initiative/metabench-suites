/-
Run from the root of this repository with:

  METABENCH=<harness checkout> ./bench-run.sh <mathlib-checkout> suites/Interval.lean
-/
module

meta import Mathlib.Tactic.Inclusion.Extension.IntervalDyadicReal.Exp
import Mathlib.Tactic.Inclusion.Extension.IntervalDyadicReal.Tactic
import MetaBench

#benchmark "exp/1/bits100" in example :
    Real.exp 1 < 2.7182818284590452353602874713528 := by
  dyadic_interval [prec := 108]

#benchmark "exp/1/bits1000" in example :
    Real.exp 1 < 2. := by
  dyadic_interval [prec := 1008]

#benchmark "exp/1/bits10000" in example :
    Real.exp 1 < 2. := by
  dyadic_interval [prec := 10008]

#benchmark "exp/10.1/bits2000" in example :
    Real.exp 10.1 < 24343. := by
  dyadic_interval [prec := 2023]

#benchmark "exp/0.3/bits2000" in example :
    Real.exp 0.3 < 1. := by
  dyadic_interval [prec := 2008]
